# ─────────────────────────────────────────────────────────────
# Innovatrix — environment
#
# Copy to .env.local and fill in. The app validates this file at boot
# (src/config/env.ts) and refuses to start if anything is missing or
# malformed, naming the variable.
#
# NEVER put a secret behind NEXT_PUBLIC_ — those are inlined into the
# browser bundle (§88).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Core ─────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Database (ticket 01) ─────────────────────────────────────
# Transactions require a replica set. `npm run db:up` starts a
# single-node replica set locally; Atlas provides one by default.
MONGODB_URI=mongodb://localhost:27017/innovatrix?replicaSet=rs0
MONGODB_DB_NAME=innovatrix

# ── Auth (ticket 03) ─────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ── Object storage (ticket 05) ───────────────────────────────
# S3-compatible. Bucket must be PRIVATE — no anonymous read (§66).
#
# STORAGE_ENDPOINT: leave EMPTY for AWS S3 (the SDK derives the host from
# region). Set it only for S3-compatible providers (Cloudflare R2, MinIO),
# which also switches the client to path-style addressing.
STORAGE_BUCKET=innovatrix-dev
STORAGE_REGION=us-east-2
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
# Root prefix for every object. The environment is appended automatically, so
# keys become `innovatrix/development/...`. Required when the bucket is shared
# with other applications — see src/services/storage/keys.ts.
STORAGE_KEY_PREFIX=innovatrix


# ── Encryption at rest (ticket 07, §89) ──────────────────────
# Encrypts demo credentials. 32 bytes as 64 hex chars:
# openssl rand -hex 32
ENCRYPTION_KEY=

# ── Payments (ticket 12) ─────────────────────────────────────
# Keys live here, never in the database. The admin UI only records
# WHICH provider serves which currency.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── AI (ticket 16) ───────────────────────────────────────────
# OpenRouter is an OpenAI-compatible gateway, so the OpenAI SDK is used
# with this baseURL. Model ids are "vendor/model" — we can still route to
# Claude, we just don't call Anthropic directly.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-opus-4.1
# Sent to OpenRouter for attribution on their dashboard/leaderboards.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Innovatrix


# ── Email (ticket 24) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@innovatrix.com

# ── Jobs (ticket 25) ─────────────────────────────────────────
# Guards the scheduled-job endpoints so they aren't publicly triggerable.
CRON_SECRET=

# ── Public (safe to expose — inlined into the browser bundle) ─
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Innovatrix
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
NEXT_PUBLIC_SENTRY_DSN=
