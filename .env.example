# ─────────────────────────────────────────────────────────────
# Innovatrix — environment
#
# Copy to .env.local and fill in. The app validates this file at boot
# (src/config/env.ts) and refuses to start if anything is missing or
# malformed, naming the variable.
#
# NEVER put a secret behind NEXT_PUBLIC_ — those are inlined into the
# browser bundle (§88).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Core ─────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Database (ticket 01) ─────────────────────────────────────
# Transactions require a replica set. `npm run db:up` starts a
# single-node replica set locally; Atlas provides one by default.
MONGODB_URI=mongodb://localhost:27017/innovatrix?replicaSet=rs0
MONGODB_DB_NAME=innovatrix
# Leave unset to derive from the URI (mongodb+srv, or ?replicaSet=). Set it
# only to override that guess. A standalone mongod cannot run transactions, and
# Better Auth's adapter turns them ON by default — see supportsTransactions().
MONGODB_TRANSACTIONS=

# ── Auth (ticket 03) ─────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Verified email gates checkout, not browsing (§75).
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_SESSION_DAYS=30

# ── Object storage (ticket 05) ───────────────────────────────
# S3-compatible. Bucket must be PRIVATE — no anonymous read (§66).
#
# STORAGE_ENDPOINT: leave EMPTY for AWS S3 (the SDK derives the host from
# region). Set it only for S3-compatible providers (Cloudflare R2, MinIO),
# which also switches the client to path-style addressing.
STORAGE_BUCKET=innovatrix-dev
STORAGE_REGION=us-east-2
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
# Root prefix for every object. The environment is appended automatically, so
# keys become `innovatrix/development/...`. Required when the bucket is shared
# with other applications — see src/services/storage/keys.ts.
STORAGE_KEY_PREFIX=innovatrix


# ── Encryption at rest (ticket 07, §89) ──────────────────────
# Encrypts demo credentials. 32 bytes as 64 hex chars:
# openssl rand -hex 32
ENCRYPTION_KEY=

# ── Payments (ticket 12) ─────────────────────────────────────
# Keys live here, never in the database. The admin UI only records
# WHICH provider serves which currency.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live. Defaults to sandbox — guessing wrong towards live means
# charging a real card during testing.
PAYPAL_ENV=sandbox

# ── AI (ticket 16) ───────────────────────────────────────────
# OpenRouter is an OpenAI-compatible gateway, so the OpenAI SDK is used
# with this baseURL. Model ids are "vendor/model" — we can still route to
# Claude, we just don't call Anthropic directly.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# The fallback. /admin/settings/ai wins over this, so switching model in
# production is a click rather than a deploy.
# Whatever you set here must support structured output, or requirement
# extraction cannot run — check `supported_parameters` on
# https://openrouter.ai/api/v1/models before changing it.
OPENROUTER_MODEL=google/gemini-3.7-flash
# Sent to OpenRouter for attribution on their dashboard/leaderboards.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Innovatrix


# ── Email (ticket 24) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@innovatrix.com

# ── Scheduled work (tickets 13, 25) ──────────────────────────
# Guards /api/cron/*, including ticket 13's reconciliation sweep, which
# re-drives stuck webhooks and verifies payments a provider never confirmed.
# The routes refuse to run when this is unset rather than running
# unauthenticated — an open reconciliation endpoint is a way to hammer three
# payment providers on demand.
#   openssl rand -hex 32
CRON_SECRET=

# ── Background jobs (ticket 25) ──────────────────────────────
# inline = a worker runs inside the Next.js process (right for a container
# host). off = the queue is drained only by /api/cron/tick (right for
# serverless, where nothing is long-lived and every instance would poll).
JOBS_WORKER=inline
JOBS_POLL_MS=5000
# How long a claimed job is honoured before another worker may take it. Must
# exceed the slowest handler, or a long job runs twice at once.
JOBS_VISIBILITY_TIMEOUT_MS=300000

# ── Public (safe to expose — inlined into the browser bundle) ─
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Innovatrix
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
NEXT_PUBLIC_SENTRY_DSN=

SMTP_PASSWORD=fake-password
SMTP_USERNAME=hello@jerrywap.com
SMTP_HOST=jerrywap.com
SMTP_PORT=465
