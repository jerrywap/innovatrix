{
  "name": "cosetup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "db:indexes": "tsx --conditions=react-server --env-file=.env.local scripts/sync-indexes.ts",
    "db:backfill:catalogue": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-catalogue.ts",
    "db:backfill:customization": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-customization.ts",
    "db:docs": "tsx scripts/generate-docs.ts",
    "storage:probe": "tsx --conditions=react-server --env-file=.env.local scripts/storage-probe.ts",
    "db:prod:bootstrap": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/prod-bootstrap.ts",
    "db:prod:reset": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/prod-reset.ts",
    "db:seed:analytics": "tsx --conditions=react-server --env-file=.env.local scripts/seed-analytics.ts",
    "db:seed:bulk": "tsx --conditions=react-server --env-file=.env.local scripts/seed-bulk.ts",
    "db:explain": "tsx --conditions=react-server --env-file=.env.local scripts/explain-marketplace.ts",
    "storage:media-probe": "tsx --conditions=react-server --env-file=.env.local scripts/media-upload-probe.ts",
    "ai:probe": "tsx --conditions=react-server --env-file=.env.local scripts/ai-probe.ts",
    "requests:probe": "tsx --conditions=react-server --env-file=.env.local scripts/request-probe.ts",
    "email:preview": "tsx --conditions=react-server --env-file=.env.local scripts/email-preview.ts",
    "db:explain:analytics": "tsx --conditions=react-server --env-file=.env.local scripts/explain-analytics.ts",
    "db:explain:queues": "tsx --conditions=react-server --env-file=.env.local scripts/explain-queues.ts",
    "jobs:probe": "tsx --conditions=react-server --env-file=.env.local scripts/jobs-probe.ts",
    "vendors:probe": "tsx --conditions=react-server --env-file=.env.local scripts/vendors-probe.ts",
    "payments:probe": "tsx --conditions=react-server --env-file=.env.local scripts/payments-probe.ts",
    "notify:probe": "tsx --conditions=react-server --env-file=.env.local scripts/notify-probe.ts",
    "scan:bundle": "tsx --env-file-if-exists=.env.local scripts/bundle-secret-scan.ts",
    "audit:deps": "npm audit --audit-level=high",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.2",
    "nanoid": "^5.1.16",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "openai": "^6.49.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19"
  }
}
